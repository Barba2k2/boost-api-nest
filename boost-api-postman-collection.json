    {
      "name": "🏆 Sistema de Pontuação",
      "item": [
        {
          "name": "Criar Score (Privado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"streamerId\": :id},\n  \"points\": 10,\n  \"reason\": \"Completou stream de 2 horas\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/scores",
              "host": ["{{base_url}}"],
              "path": ["scores"]
            }
          },
          "response": []
        },
        {
          "name": "Consultar Pontos Diários (Privado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scores/daily-points/:id}?date=2025-01-04",
              "host": ["{{base_url}}"],
              "path": ["scores", "daily-points", ":id}"],
              "query": [
                {
                  "key": "date",
                  "value": "2025-01-04",
                  "description": "Data no formato YYYY-MM-DD (opcional)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar Pontos Diários (Público)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scores/public/daily-points/:id}?date=2025-01-04",
              "host": ["{{base_url}}"],
              "path": ["scores", "public", "daily-points", ":id}"],
              "query": [
                {
                  "key": "date",
                  "value": "2025-01-04",
                  "description": "Data no formato YYYY-MM-DD (opcional)"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
