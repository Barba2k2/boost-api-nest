            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Maria Santos\",\n  \"nickname\": \"mariasantos\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"MinhaSenh@123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
