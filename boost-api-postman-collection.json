                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"novo_access_token\",\n  \"refreshToken\": \"novo_refresh_token\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/:id/tokens",
              "host": ["{{base_url}}"],
              "path": ["users", ":id", "tokens"]
            }
          },
          "response": []
        }
      ]
    },
