              "raw": "{{base_url}}/users/:id",
              "host": ["{{base_url}}"],
              "path": ["users", ":id"]
            }
          },
          "response": []
        },
        {
          "name": "Atualizar Tokens do Usuário",
          "request": {
            "method": "PATCH",
            "header": [
